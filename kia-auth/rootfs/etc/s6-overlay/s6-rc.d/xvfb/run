#!/command/with-contenv bashio
# Xvfb — virtual framebuffer. Chromium renders into this, x11vnc scrapes it.
# Slightly larger mobile-like viewport for easier CAPTCHA interaction.

bashio::log.info "Starting Xvfb on display :99 (540x1100x24)"
exec /usr/bin/Xvfb :99 -screen 0 540x1100x24 -nolisten tcp
